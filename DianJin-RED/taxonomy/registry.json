    {
      "id": "E5",
      "name": "mcp_service_injection",
      "zh": "MCP 服务注入",
      "axis": "intervention"
    },
    {
      "id": "T1",
      "name": "dependency_injection",
      "zh": "依赖注入",
      "axis": "intervention"
    },
    {
      "id": "T2",
      "name": "api_documentation_poisoning",
