        "E4",
        "E5"
      ]
    },
    {
      "id": "external_tool_data_monitor",
      "zh": "外部工具/数据监控",
      "en": "External Tool/Data Monitor",
      "intervention_ids": [
        "T1",
        "T2",
        "T3",
        "T4"
      ]
    }
  ],
  "interventions": [
